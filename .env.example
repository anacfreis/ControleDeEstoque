# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/controle_estoque?schema=public"

# Segredo usado para assinar os tokens de login (JWT).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte

# Porta do servidor (opcional, padrão 3333)
PORT=3333